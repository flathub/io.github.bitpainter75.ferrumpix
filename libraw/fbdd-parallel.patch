 #include "../../internal/dcraw_defs.h"
 
+#ifdef LIBRAW_USE_OPENMP
+#include <atomic>
+#include <memory>
+#ifndef _WIN32
+#include <sched.h>
+#endif
+
+// FBDD runs in place in two of its passes: fbdd_green and the last pass of
+// dcb_color_full read the already updated values of the row above (and, for
+// dcb_color_full, of the pixel to the left) and the not yet updated values of
+// the row below. A plain parallel loop over rows would change the result.
+// fbdd_wavefront keeps the serial order of every read: rows are dealt to the
+// threads in turn, and row i computes a block of columns only after row i-1
+// has finished the block after it. Row i-1 then has written every value row i
+// reads above it, and has read every old value of row i before row i
+// overwrites it. The arithmetic is unchanged, so the output is identical to
+// the serial run for any number of threads.
+#define FBDD_WAVEFRONT_BLOCK 256
+
+static inline void fbdd_wavefront_yield()
+{
+#ifdef _WIN32
+  SwitchToThread();
+#else
+  sched_yield();
+#endif
+}
+
+template <typename RowSpan>
+static void fbdd_wavefront(int r0, int r1, int c_lo, int c_hi, RowSpan span)
+{
+  const int rows = r1 - r0;
+  if (rows <= 0 || c_hi <= c_lo)
+    return;
+  std::unique_ptr<std::atomic<int>[]> progress(new std::atomic<int>[rows]);
+  for (int i = 0; i < rows; i++)
+    progress[i].store(c_lo, std::memory_order_relaxed);
+#pragma omp parallel
+  {
+    const int t = omp_get_thread_num(), n = omp_get_num_threads();
+    for (int i = t; i < rows; i += n)
+      for (int c0 = c_lo; c0 < c_hi; c0 += FBDD_WAVEFRONT_BLOCK)
+      {
+        const int c1 = MIN(c0 + FBDD_WAVEFRONT_BLOCK, c_hi);
+        if (i > 0)
+        {
+          const int need = MIN(c1 + FBDD_WAVEFRONT_BLOCK, c_hi);
+          int spins = 0;
+          while (progress[i - 1].load(std::memory_order_acquire) < need)
+            if (++spins > 2000)
+            {
+              fbdd_wavefront_yield();
+              spins = 0;
+            }
+        }
+        span(r0 + i, c0, c1);
+        progress[i].store(c1, std::memory_order_release);
+      }
+  }
+}
+#endif
+
